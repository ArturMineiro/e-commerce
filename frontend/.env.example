# Endereço da API (Laravel)
VITE_API_URL=http://localhost:8000/api

# ---------------------------------------------------------------
# Plataforma (site de vendas + lojas em site.com/nome-da-loja)
# ---------------------------------------------------------------
# Nome exibido na marca da plataforma (padrão: Lojaria)
VITE_PLATAFORMA_NOME=
# Endereço público do site da plataforma (vazio = o próprio endereço aberto no navegador)
VITE_PLATAFORMA_URL=
# Hosts que mostram o site da plataforma (separados por vírgula)
VITE_PLATAFORMA_HOSTS=localhost,127.0.0.1
# Domínio base para lojas em subdomínio (ex.: lojaria.com.br → ana.lojaria.com.br)
VITE_PLATAFORMA_DOMINIO=
# 1 = links das lojas em subdomínio em vez de site.com/nome-da-loja
VITE_LOJAS_EM_SUBDOMINIO=

# Build de uma loja só (ignora a plataforma): slug da loja
VITE_LOJA=
