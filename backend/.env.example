APP_NAME=Loja
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ecommerce
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# log = grava os e-mails em storage/logs/laravel.log (desenvolvimento). Em producao use smtp.
MAIL_MAILER=log
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

APP_TIMEZONE=America/Sao_Paulo
# URL do front (links de retorno do pagamento) e origens liberadas no CORS
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Lojas em subdominios (ex.: #^https://[a-z0-9-]+\.minhaplataforma\.com$#)
CORS_ALLOWED_ORIGINS_PATTERNS=

# Multi-loja
# Dominio base: a loja "ana" responde em ana.minhaplataforma.com (vazio = sem subdominios)
PLATAFORMA_DOMINIO=
# Slug da loja usada quando a requisicao nao indica nenhuma (vazio + 1 loja so = usa essa)
LOJA_PADRAO=

# Opcional: o dono da loja pode informar o token pelo painel (Configuracoes da loja)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Gerado por: php artisan jwt:secret
JWT_SECRET=
JWT_TTL=1440

# Usuarios criados por: php artisan db:seed (senha padrao Senha1234 - troque em producao)
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@loja.com
SEED_ADMIN_PASSWORD=
SEED_CLIENTE_NAME="Cliente Teste"
SEED_CLIENTE_EMAIL=cliente@loja.com
SEED_CLIENTE_PASSWORD=
# Administrador da plataforma (cria e gerencia as lojas em /plataforma)
SEED_PLATAFORMA_NAME=Plataforma
SEED_PLATAFORMA_EMAIL=plataforma@loja.com
SEED_PLATAFORMA_PASSWORD=
# Loja onde o seed cria o admin e o cliente
SEED_LOJA_SLUG=loja
